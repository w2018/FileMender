#pragma code_page(65001)
#include <windows.h>

1 ICON "app.ico"
1 24 "app.manifest"

#ifndef FM_VER_MAJOR
#define FM_VER_MAJOR 1
#endif
#ifndef FM_VER_MINOR
#define FM_VER_MINOR 0
#endif
#ifndef FM_VER_PATCH
#define FM_VER_PATCH 0
#endif
#define FM_STR2(x) #x
#define FM_STR(x) FM_STR2(x)
#undef FM_VER_DOT
#define FM_VER_DOT FM_STR(FM_VER_MAJOR) "." FM_STR(FM_VER_MINOR) "." FM_STR(FM_VER_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FM_VER_MAJOR,FM_VER_MINOR,FM_VER_PATCH,0
PRODUCTVERSION FM_VER_MAJOR,FM_VER_MINOR,FM_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "曾先生"
            VALUE "FileDescription", "文件属性修改器"
            VALUE "FileVersion", FM_VER_DOT
            VALUE "InternalName", "FileMender"
            VALUE "LegalCopyright", "Copyright (C) 2026 曾先生"
            VALUE "OriginalFilename", "FileMender.exe"
            VALUE "ProductName", "文件属性修改器"
            VALUE "ProductVersion", FM_VER_DOT
            VALUE "Comments", "纯 C + Win32 单文件工具；修改文件名与时间戳，本地计算 MD5/SHA-1/SHA-256"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
